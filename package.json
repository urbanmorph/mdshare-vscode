{
  "name": "mdshare-live",
  "displayName": "mdshare - Share Markdown",
  "description": "Share markdown files instantly via mdshare.live",
  "version": "0.3.1",
  "publisher": "urbanmorph",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "share",
    "mdshare"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/urbanmorph/mdshare-vscode"
  },
  "homepage": "https://mdshare.live",
  "bugs": {
    "url": "https://github.com/urbanmorph/mdshare-vscode/issues"
  },
  "icon": "icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdshare.shareFile",
        "title": "Share on mdshare"
      },
      {
        "command": "mdshare.shareSelection",
        "title": "Share Selection on mdshare"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdshare.shareFile",
          "when": "resourceLangId == markdown",
          "group": "mdshare"
        }
      ],
      "editor/context": [
        {
          "command": "mdshare.shareSelection",
          "when": "editorHasSelection",
          "group": "mdshare"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
